# --- Neon (Postgres + Object Storage) ---
# Ditulis otomatis oleh `neon deploy` ke .env.local. Jangan diisi manual.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AI: provider yang diizinkan hanya NVIDIA API Catalog dan OpenRouter (lihat CLAUDE.md aturan 10).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
# Format "<nvidia|openrouter>:<model id>". Utama dicoba dulu (reasoning off, ulang dengan reasoning on
# kalau output tidak valid), lalu cadangan kalau gagal/429/5xx/timeout.
LLM_MODEL=openrouter:nvidia/nemotron-3-super-120b-a12b:free
LLM_FALLBACK_MODEL=nvidia:nvidia/nemotron-3-super-120b-a12b
# AI — batas pemakaian
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_DEMO=10
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
APP_URL=http://localhost:3000
# Demo: tombol "Masuk sebagai demo" (akun demo@lamarin.local dari `pnpm db:seed`).
# DEMO_READ_ONLY=true di produksi supaya pengunjung hanya bisa melihat; kosongkan di lokal/CI agar E2E bisa menulis.
DEMO_LOGIN_ENABLED=true
DEMO_READ_ONLY=
