# --- Neon (Postgres + Object Storage) ---
# Ditulis otomatis oleh `neon deploy` ke .env.local. Jangan diisi manual.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AI (lihat CLAUDE.md aturan 10 dan 7.8). Produksi: Groq (utama) + Cloudflare Workers AI (cadangan).
# Semua model provider utama dicoba dulu (GROQ_MODEL, lalu GROQ_FALLBACK_MODEL), baru provider cadangan.
LLM_PRIMARY=groq
LLM_FALLBACK=cloudflare
GROQ_API_KEY=
# 20b: akurasi sama dengan 120b di uji fixture, ±1 dtk vs ±2,5 dtk. Output yang gagal valid naik ke 120b.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Khusus dev (ditolak kalau NODE_ENV=production): pilih dengan LLM_PRIMARY/LLM_FALLBACK=nvidia|openrouter.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# AI — batas pemakaian
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_DEMO=10
RESEND_API_KEY=
EMAIL_FROM=
CRON_SECRET=
APP_URL=http://localhost:3000
# Demo: tombol "Masuk sebagai demo" (akun demo@lamarin.local dari `pnpm db:seed`).
# DEMO_READ_ONLY=true di produksi supaya pengunjung hanya bisa melihat; kosongkan di lokal/CI agar E2E bisa menulis.
DEMO_LOGIN_ENABLED=true
DEMO_READ_ONLY=
