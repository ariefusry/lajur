generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // .ts import extensions let `node` run prisma/seed.ts directly (no tsx needed)
  importFileExtension = "ts"
}

// Connection URLs live in prisma.config.ts (CLI) and src/lib/db.ts (runtime adapter).
datasource db {
  provider = "postgresql"
}

// ---------- Auth.js (Prisma adapter) ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- App ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // profil untuk cek kelayakan
  gpa           Decimal?  @db.Decimal(3, 2) // skala 4.00
  birthDate     DateTime? @db.Date
  major         String?
  degree        Degree?
  domicile      String?
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  resumes      Resume[]
  stages       Stage[]
  applications Application[]
}

enum Degree {
  SMA
  D1
  D2
  D3
  D4
  S1
  S2
  S3
}

model Resume {
  id            String        @id @default(cuid())
  userId        String
  versionName   String
  filePath      String // key di bucket, BUKAN URL publik
  extractedText String?       @db.Text
  createdAt     DateTime      @default(now())
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications  Application[]

  @@index([userId])
}

model Stage {
  id           String         @id @default(cuid())
  userId       String
  name         String
  order        Int
  kind         StageKind      @default(IN_PROGRESS)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]
  history      StageHistory[]

  @@index([userId, order]) // bukan unique, supaya reorder tidak bentrok
}

enum StageKind {
  WISHLIST
  IN_PROGRESS
  OFFER
  REJECTED
  WITHDRAWN
}

model Application {
  id                 String    @id @default(cuid())
  userId             String
  resumeId           String?
  currentStageId     String
  company            String
  position           String
  source             JobSource
  url                String?
  jobPostingText     String?   @db.Text
  location           String?
  deadline           DateTime?
  expectedSalary     Int? // rupiah per bulan
  notes              String?   @db.Text
  appliedAt          DateTime?
  // Follow-up: when to chase the company next, when the user last did, and whether the email reminder went out.
  nextActionAt       DateTime?
  lastFollowUpAt     DateTime?
  followUpRemindedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume       Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  currentStage Stage          @relation(fields: [currentStageId], references: [id])
  history      StageHistory[]
  events       Event[]
  requirements Requirement[]
  skillGaps    SkillGap[]

  @@index([userId, currentStageId])
  @@index([nextActionAt])
}

enum JobSource {
  JOBSTREET
  KALIBRR
  GLINTS
  LINKEDIN
  COMPANY_SITE
  BUMN_PORTAL
  INSTAGRAM
  REFERRAL
  OTHER
}

model StageHistory {
  id            String       @id @default(cuid())
  applicationId String
  stageId       String
  enteredAt     DateTime     @default(now())
  result        StageResult?
  notes         String?      @db.Text
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         Stage        @relation(fields: [stageId], references: [id])

  @@index([applicationId])
}

enum StageResult {
  PASSED
  FAILED
  PENDING
}

model Event {
  id            String      @id @default(cuid())
  applicationId String
  type          EventType
  startsAt      DateTime
  locationOrUrl String?
  remindedH3At  DateTime?
  remindedH1At  DateTime?
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([startsAt])
}

enum EventType {
  DEADLINE
  ONLINE_TEST
  PSYCHOTEST
  LGD
  INTERVIEW_HR
  INTERVIEW_USER
  MCU
  OTHER
}

model Requirement {
  id               String            @id @default(cuid())
  applicationId    String
  type             RequirementType
  value            String
  ageReferenceDate DateTime?         @db.Date // MAX_AGE: "usia maks. 25 tahun per 31 Desember 2026"
  sourceQuote      String            @db.Text
  status           EligibilityStatus @default(UNKNOWN)
  reason           String?
  editedByUser     Boolean           @default(false)
  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

enum RequirementType {
  MIN_GPA
  MAX_AGE
  MAJOR
  MIN_DEGREE
  PLACEMENT
  SERVICE_BOND
  OTHER
}

enum EligibilityStatus {
  MEETS
  WARNING
  FAILS
  UNKNOWN
}

model AiUsage {
  id      String    @id @default(cuid())
  userId  String
  day     DateTime  @db.Date // tanggal Asia/Jakarta
  feature AiFeature
  model   String
  count   Int       @default(0)

  @@unique([userId, day, feature, model])
}

enum AiFeature {
  EXTRACT_JOB
  SKILL_GAP
}

model ExtractionCache {
  id        String   @id @default(cuid())
  textHash  String   @unique
  result    Json
  model     String
  createdAt DateTime @default(now())
}

model SkillGap {
  id            String      @id @default(cuid())
  applicationId String
  skill         String
  inResume      Boolean
  suggestion    String?
  sourceQuote   String?     @db.Text
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}
